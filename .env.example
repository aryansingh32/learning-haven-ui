# ═══════════════════════════════════════════════════════════
# Learning Haven — Environment Variables
# Copy this file to .env and fill in real values
# ═══════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_ANON_KEY=<supabase-anon-or-publishable-key>
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
PG_POOL_MAX=20

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────
# Must be at least 32 characters
JWT_SECRET=change_this_to_a_strong_random_string_at_least_32_chars
SUPABASE_AUTH_TIMEOUT_MS=12000

# ── Razorpay ─────────────────────────────────────────────
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── AI / LLM ─────────────────────────────────────────────
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=<openrouter-api-key>

# ── Email (Resend) ───────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key

# ── GitHub ───────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_BOT_TOKEN=<github-bot-token>
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
GITHUB_TOKEN_ENCRYPTION_KEY=change_this_to_a_strong_random_string_at_least_32_chars
WEBHOOK_BASE_URL=https://api.learninghaven.com

# ── Frontend ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
VITE_RAZORPAY_KEY_ID=<razorpay-key-id>

# ── Metrics ──────────────────────────────────────────────
METRICS_SECRET_TOKEN=your_metrics_secret_token

# ── Workers ──────────────────────────────────────────────
WORKER_CONCURRENCY=10
BUILD_WORKER_CONCURRENCY=5
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
REDIS_CONNECT_TIMEOUT_MS=5000

# ── Apprenticeship ───────────────────────────────────────
APPRENTICESHIP_DISCORD_INVITE=

# ── Admin Script (only for create-admin.ts) ──────────────
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change_me
