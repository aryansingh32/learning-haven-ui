# Student frontend (Vite) — copy to `.env.local` in this directory and restart `npm run dev`
# (Project root has a `.env/` Python venv folder; use `.env.local` for Vite.)
# Use the same Supabase project as backend/.env

VITE_API_BASE_URL=http://localhost:5000/api

# Required for automatic session refresh (without these, refresh falls back to POST /api/auth/refresh only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Optional
VITE_RAZORPAY_KEY_ID=
