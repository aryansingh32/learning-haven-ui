# Forge Campus API
PORT=5100
NODE_ENV=development
# Same database as the Forge API. The connecting role must be able to SET ROLE authenticated
# (true for Supabase's `postgres` user) so queries run under row-level security.
DATABASE_URL=postgresql://postgres:password@db.<project>.supabase.co:5432/postgres
# Tokens are verified locally against the project's JWKS (ES256).
SUPABASE_URL=https://<project>.supabase.co
# Optional: legacy HS256 JWT secret (also used by the test suite).
# SUPABASE_JWT_SECRET=
# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5175
# Code judge for coding questions: your self-hosted Judge0 CE. Without it, development
# runs code locally and production marks coding answers "grading pending" (staff regrade later).
# JUDGE0_URL=http://judge0.internal:2358
# JUDGE0_AUTH_TOKEN=

# Notifications (optional). Reminders and emails run when a cron service calls
#   POST /campus/internal/scheduler  with header  x-cron-secret: <CRON_SECRET>
# (every 10–15 minutes is plenty), or set SCHEDULER_MINUTES to run them inside
# a single server instance. Without RESEND_API_KEY, notifications are in-app only.
CRON_SECRET=
SCHEDULER_MINUTES=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Forge Campus <noreply@your-domain>
APP_URL=http://localhost:5173

# College portals at https://<slug>.<this domain> may call this API (CORS).
CAMPUS_BASE_DOMAIN=forge.com
