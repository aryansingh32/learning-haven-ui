# Forge Campus API
PORT=5100
NODE_ENV=development
# Same database as the Forge API. The connecting role must be able to SET ROLE authenticated
# (true for Supabase's `postgres` user) so queries run under row-level security.
DATABASE_URL=postgresql://postgres:password@db.<project>.supabase.co:5432/postgres
# Tokens are verified locally against the project's JWKS (ES256).
SUPABASE_URL=https://<project>.supabase.co
# Optional: legacy HS256 JWT secret (also used by the test suite).
# SUPABASE_JWT_SECRET=
# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5175
