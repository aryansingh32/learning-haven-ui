# Forge learner app (apps/web). Copy to .env and fill in.

# Forge API. In dev, leave as /api to use the Vite proxy to http://localhost:5000.
VITE_API_BASE_URL=/api

# Supabase project (public values only — never the service-role key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay public key id for checkout.
VITE_RAZORPAY_KEY_ID=

# Forge Campus API (college tests, "My College").
# Dev: leave unset — /campus/v1 is proxied to CAMPUS_API_URL (default http://localhost:5100).
# Prod: the deployed Campus API, e.g. https://campus-api.example.com/campus/v1
#       and add this app's origin to the Campus API's CORS_ORIGINS.
# VITE_CAMPUS_API_URL=
# CAMPUS_API_URL=http://localhost:5100
