# Production: where the portal finds the two APIs (dev uses the Vite proxy).
VITE_FORGE_API_URL=https://api.example.com
VITE_CAMPUS_API_URL=https://campus-api.example.com
# Where students go to take their tests.
VITE_STUDENT_APP_URL=https://app.example.com
# Each college's portal is <slug>.<this domain> (vit.forge.com). Point a wildcard DNS
# record (*.forge.com) and a wildcard TLS certificate at this app. Dev: vit-demo.localhost:5175.
VITE_CAMPUS_BASE_DOMAIN=forge.com
