PORT=5000
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
# JWT signing keys (JWKS JSON, one line) — Dashboard → Settings → API → JWT Signing Keys
SUPABASE_JWT_JWKS={"keys":[{"x":"...","y":"...","alg":"ES256","crv":"P-256","kid":"...","kty":"EC","key_ops":["verify"]}]}
# Legacy HS256 JWT secret (optional) — same page, "JWT Secret" if still shown
SUPABASE_JWT_SECRET=
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key

# OpenAI
OPENAI_API_KEY=your_openai_api_key
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Learning Haven <noreply@learninghaven.com>

# WhatsApp Cloud API (Meta Business)
# Get these from https://developers.facebook.com > WhatsApp > Getting Started
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
WHATSAPP_TOKEN=your_whatsapp_permanent_access_token
# This token is sent by your external cron scheduler at webhook registration
WHATSAPP_VERIFY_TOKEN=dsaos_webhook_secret

# Cron secret (used by external schedulers like cron-job.org or Vercel Cron)
# Include this as x-cron-secret header in your cron HTTP requests
CRON_SECRET=your_strong_random_cron_secret

# Payment
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Redis (optional for caching)
REDIS_URL=redis://localhost:6379
PG_POOL_MAX=20
WORKER_CONCURRENCY=10

# Apprenticeship / GitHub automation
GITHUB_CLIENT_ID=<github-oauth-client-id>
GITHUB_CLIENT_SECRET=<github-oauth-client-secret>
GITHUB_ORG_NAME=learning-haven
GITHUB_BOT_TOKEN=<github-bot-token>
GITHUB_TOKEN_ENCRYPTION_KEY=change_this_to_a_strong_random_string_at_least_32_chars
WEBHOOK_BASE_URL=https://api.learninghaven.com
FRONTEND_URL=http://localhost:5173
# GitHub OAuth callback (register this exact URL in your GitHub OAuth app settings).
# Defaults to ${WEBHOOK_BASE_URL}/api/v1/apprenticeship/auth/github/callback
# GITHUB_OAUTH_CALLBACK_URL=
APPRENTICESHIP_DISCORD_INVITE=
